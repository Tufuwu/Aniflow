# ─────────────────────────────────────────────────────────────────
#  AniFlow Environment Configuration
# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys as needed.
# Only required if using cloud AI services (Gemini/Claude/ElevenLabs).

# ─── Flask (optional — only matters if exposing to a network) ────
# FLASK_SECRET_KEY=change-me-to-a-random-string

# ─── AI Narration (optional — use Ollama locally instead) ────────
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_claude_api_key_here

# ─── First-chapter Story pipeline (independent of legacy narration) ───
# STORY_API_BASE=https://api.deepseek.com
# STORY_API_KEY=your_deepseek_api_key_here
# STORY_VISION_MODEL=deepseek-flash
# STORY_WRITER_MODEL=deepseek-flash
# STORY_SCRIPT_MODEL=openai/gpt-6-luna
# STORY_SCRIPT_API_BASE=https://openrouter.ai/api
# STORY_SCRIPT_API_KEY=your_openrouter_api_key_here
# STORY_POLISH_MODEL=openai/gpt-6-luna
# STORY_POLISH_API_BASE=https://openrouter.ai/api
# STORY_POLISH_API_KEY=your_openrouter_api_key_here
# STORY_CHECKER_MODEL=deepseek-flash
# Integration, planning and script writing can use independent OpenRouter routes.
# STORY_INTEGRATION_MODEL=openai/gpt-6-luna
# STORY_INTEGRATION_API_BASE=https://openrouter.ai/api
# STORY_INTEGRATION_API_KEY=your_openrouter_api_key_here
# STORY_PLANNING_MODEL=openai/gpt-6-luna
# STORY_PLANNING_API_BASE=https://openrouter.ai/api
# STORY_PLANNING_API_KEY=your_openrouter_api_key_here

# ─── 9router (Alternative to Ollama) ─────────────────────────────
# USE_NINE_ROUTER=1
# NINE_ROUTER_HOST=http://127.0.0.1:20128
# NINE_ROUTER_API_KEY=your_9router_api_key_here
# VISION_MODEL=Free-Tier
# WRITER_MODEL=Free-Tier
# TEXT_WRITER_MODEL=Free-Tier

# ─── Text-to-Speech (optional — use Edge TTS free or Kokoro local) ──
# ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ─── MyAnimeList Character Import (optional) ─────────────────────
# MAL_CLIENT_ID=your_mal_client_id_here
